NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/drogueria?retryWrites=true&w=majority

# URL(s) del frontend permitidas por CORS, separadas por coma
CLIENT_URL=http://localhost:5173

# Secretos JWT (mínimo 32 caracteres, distintos entre sí)
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-1
JWT_REFRESH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-2
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Proxies delante de la API: 1 si el frontend llama directo a Render;
# 2 si el frontend usa el rewrite de Vercel (Vercel -> Render)
TRUST_PROXY_HOPS=1

# Cookies: en producción con rewrite de Vercel se deja "lax"
COOKIE_SAMESITE=lax

# Resend (recuperación de contraseña e invitaciones)
RESEND_API_KEY=
EMAIL_FROM=Droguería <onboarding@resend.dev>
